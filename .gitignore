# Logs
# Root-level log output only. A bare `logs` also matched src/app/admin/logs/,
# and the admin Logs page went uncommitted for weeks without anyone noticing.
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Next.js build and cache outputs
.next/
*.tsbuildinfo
test-results/
.env*.local


.vercel
.open-next
scratch/

# Playwright artifacts (screenshots/reports are regenerated on every run)
playwright-report/
tests/evidence/
tests/**/*.png
tests/**/*.webm

# Cloudflare / Wrangler local state
.wrangler/

# Local cleanup quarantine (review, then delete)
.cleanup-quarantine/

# Uploaded documents in local development. Never committed.
.data/
