# @opennextjs/cloudflare and wrangler are leftovers from the abandoned Workers
# deploy (see CLAUDE.md, "Deployment") and declare a peer dependency on Next 15+,
# while this app is on Next 14. The local tree was always installed with
# --legacy-peer-deps; this makes every install — here and in the ARM build on
# the Oracle server — resolve the same lockfile the same way. Remove both
# packages and this file together.
legacy-peer-deps=true
